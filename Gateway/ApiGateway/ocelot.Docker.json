      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Payment/success",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/payment/success",
      "UpstreamHttpMethod": [ "Post" ]
    },
    {
      "DownstreamPathTemplate": "/api/Payment/fail",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/payment/fail",
      "UpstreamHttpMethod": [ "Post" ]
    },
    {
      "DownstreamPathTemplate": "/api/Payment/cancel",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/payment/cancel",
      "UpstreamHttpMethod": [ "Post" ]
    },
    {
      "DownstreamPathTemplate": "/api/Payment/ipn",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/payment/ipn",
      "UpstreamHttpMethod": [ "Post" ]
    },

    // ==================== Admin Service Routes ====================
    {
      "DownstreamPathTemplate": "/api/AdminProduct",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "admin-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/admin/product",
      "UpstreamHttpMethod": [ "Get", "Post" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/AdminProduct/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "admin-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/admin/product/{id}",
      "UpstreamHttpMethod": [ "Get", "Put", "Delete" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://apigateway:8080",
    "RateLimitOptions": {
      "DisableRateLimitHeaders": false,
      "QuotaExceededMessage": "API rate limit exceeded. Please try again later.",
      "HttpStatusCode": 429
    }
  }
}
