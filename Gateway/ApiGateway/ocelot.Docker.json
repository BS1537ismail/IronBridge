{
  "Routes": [
    // ==================== UserAuth Service Routes ====================
    {
      "DownstreamPathTemplate": "/api/Auth/register",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "userauth-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/auth/register",
      "UpstreamHttpMethod": [ "Post" ]
    },
    {
      "DownstreamPathTemplate": "/api/Auth/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "userauth-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/auth/login",
      "UpstreamHttpMethod": [ "Post" ]
    },
    {
      "DownstreamPathTemplate": "/api/Auth/user/{userId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "userauth-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/auth/user/{userId}",
      "UpstreamHttpMethod": [ "Get" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Auth/user/email/{email}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "userauth-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/auth/user/email/{email}",
      "UpstreamHttpMethod": [ "Get" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },

    // ==================== Product Service Routes ====================
    {
      "DownstreamPathTemplate": "/api/Product",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "product-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/product",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "DownstreamPathTemplate": "/api/Product/active",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "product-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/product/active",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "DownstreamPathTemplate": "/api/Product/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "product-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/product/{id}",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "DownstreamPathTemplate": "/api/Product/category/{category}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "product-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/product/category/{category}",
      "UpstreamHttpMethod": [ "Get" ]
    },

    // ==================== Booking Service Routes ====================
    {
      "DownstreamPathTemplate": "/api/Booking",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/booking",
      "UpstreamHttpMethod": [ "Get", "Post" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Booking/active",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
