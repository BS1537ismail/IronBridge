        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/booking/{id}",
      "UpstreamHttpMethod": [ "Get", "Put", "Delete" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Booking/user/{userId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/booking/user/{userId}",
      "UpstreamHttpMethod": [ "Get" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Booking/status/{status}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/booking/status/{status}",
      "UpstreamHttpMethod": [ "Get" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Booking/{id}/status",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/booking/{id}/status",
      "UpstreamHttpMethod": [ "Patch" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },

    // ==================== Payment Service Routes (Booking Service) ====================
    {
      "DownstreamPathTemplate": "/api/Payment/initiate",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "booking-service",
          "Port": 8080
